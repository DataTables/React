{
	"name": "datatables.net-react",
	"version": "2.0.0",
	"description": "React component for DataTables - The Javascript table library",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"test": "vitest run",
		"build": "rollup -c"
	},
	"keywords": [
		"react",
		"datatable",
		"datatables",
		"datatables.net",
		"table"
	],
	"author": "SpryMedia Ltd",
	"license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/React.git"
    },
	"devDependencies": {
		"@rollup/plugin-commonjs": "^26.0.3",
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-typescript": "^11.1.6",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.1",
		"datatables.net": "^3.1.2",
		"jsdom": "^30.1.1",
		"rollup": "^4.63.5",
		"rollup-plugin-dts": "^6.5.1",
		"tslib": "^2.8.1",
		"typescript": "^6",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"datatables.net": "^3.0.0",
		"react": "^18.3.1 || ^19",
		"react-dom": "^18.3.1 || ^19"
	}
}
