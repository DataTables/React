{
	"name": "datatables.net-react",
	"version": "2.0.1",
	"description": "React component for DataTables - The Javascript table library",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"type": "commonjs",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run"
	},
	"keywords": [
		"react",
		"datatable",
		"datatables",
		"datatables.net",
		"table"
	],
	"author": {
		"name": "SpryMedia Ltd",
		"url": "http://datatables.net"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DataTables/React.git"
	},
	"homepage": "https://datatables.net/manual/components/react",
	"bugs": "https://datatables.net/forums",
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.1.1",
		"datatables.net": "^3.1.2",
		"jsdom": "^30.1.1",
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"tslib": "^2.8.1",
		"typescript": "^6",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"datatables.net": "^3.0.0",
		"react": "^18.3.1 || ^19",
		"react-dom": "^18.3.1 || ^19"
	}
}
