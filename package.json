		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"rollup": "^4.63.5",
		"rollup-plugin-dts": "^6.5.1",
		"tslib": "^2.8.1",
		"typescript": "^6"
	},
	"peerDependencies": {
		"datatables.net": "^3.0.0",
		"react": "^18.3.1 || ^19",
		"react-dom": "^18.3.1 || ^19"
